{
  "name": "myra-computer-enterprises",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./src/input.css -o ./assets/css/site.css && node ./scripts/build.mjs",
    "css": "npx @tailwindcss/cli -i ./src/input.css -o ./assets/css/site.css",
    "css:watch": "npx @tailwindcss/cli -i ./src/input.css -o ./assets/css/site.css --watch",
    "serve": "node ./server.mjs"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "lucide-static": "^0.544.0",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1"
  }
}
